# ──────────────────────────────────────────────────────────────────────────────
# mbonnici.fr — what docker-compose.yml (production) expects. Never commit a filled copy.
# On Coolify only the Google client and ADMIN_EMAIL are entered by hand: the SERVICE_* ones are
# generated by Coolify on the first deployment and kept after.
# ──────────────────────────────────────────────────────────────────────────────

# Google OAuth 2.0 client (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: https://mbonnici.fr/api/auth/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Required: the Google account(s) allowed in the back office, separated by ";"
# (e.g. you@gmail.com;other@gmail.com). Every other account is rejected after Google's sign-in.
ADMIN_EMAIL=

# Generated by Coolify. Outside Coolify, set long random values (openssl rand -hex 32), once:
# the database keeps the user and password it was created with.
SERVICE_USER_POSTGRES=
SERVICE_PASSWORD_64_POSTGRES=
SERVICE_USER_S3=
SERVICE_PASSWORD_64_S3=
SERVICE_PASSWORD_64_ANALYTICS=
