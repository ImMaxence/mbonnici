# ──────────────────────────────────────────────────────────────────────────────
# mbonnici.fr — environment (copy to .env, never commit .env)
# ──────────────────────────────────────────────────────────────────────────────

# Public URL of the site (no trailing slash). Used for the OAuth redirect, sitemap,
# canonical links, llms.txt and the Content-Security-Policy.
APP_URL=https://mbonnici.fr

# The ONLY Google account allowed to sign in to the back office (comma-separated if several).
ADMIN_EMAIL=maxence.bonnici2002@gmail.com

# Google OAuth 2.0 client (https://console.cloud.google.com/apis/credentials)
# Authorised redirect URI: ${APP_URL}/api/auth/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me-long-random

# S3-compatible object storage for images (SeaweedFS in docker-compose.yml).
# The same key pair is injected into SeaweedFS and into the backend.
S3_BUCKET=portfolio-media
S3_ACCESS_KEY=portfolio
S3_SECRET_KEY=change-me-long-random

# Secret used to derive the daily rotating salt for anonymous visitor hashes.
ANALYTICS_SALT_SECRET=change-me-long-random

# Behind Cloudflare / Coolify (Traefik): trust X-Forwarded-* and CF-Connecting-IP
TRUST_PROXY=true

# Git SHA injected at build time (optional, shown in the back office)
GIT_SHA=
